diff --git a/utility/WmoLiquids.hpp b/utility/WmoLiquids.hpp
new file mode 100644
index 0000000..b8ced51
--- /dev/null
+++ b/utility/WmoLiquids.hpp
@@ -0,0 +1,96 @@
+#pragma once
+
+#include "WmoGroupFlags.hpp"
+#include <cmath>
+
+namespace utility::wmo
+{
+struct LiquidTriangle
+{
+    math::Vertex vertices[3];
+    std::uint32_t entry;
+};
+
+inline bool ValidLiquid(const LiquidTriangle& liquid)
+{
+    if (!(liquid.entry >= 1 && liquid.entry <= 4) && liquid.entry != 21)
+        return false;
+    for (const auto& vertex : liquid.vertices)
+        if (!std::isfinite(vertex.X) || !std::isfinite(vertex.Y) || !std::isfinite(vertex.Z))
+            return false;
+    return true;
+}
+
+inline std::uint32_t LiquidEntry(std::uint32_t rootFlags, std::uint32_t rootId,
+                                std::uint32_t groupFlags, std::uint32_t groupType,
+                                const std::vector<std::uint8_t>& tiles)
+{
+    auto entry = (rootFlags & 4) ? groupType : (groupType == 15 ? 0 : groupType + 1);
+    if (!entry)
+        for (auto tile : tiles)
+            if ((tile & 15) != 15)
+            {
+                entry = (tile & 15) + 1;
+                break;
+            }
+    if (entry && entry < 21)
+        switch ((entry - 1) & 3)
+        {
+            case 0: return (groupFlags & 0x80000) ? 2 : 1;
+            case 1: return 2;
+            case 2: return 3;
+            case 3: return rootId == 4489 ? 21 : 4;
+        }
+    return entry;
+}
+
+inline std::vector<LiquidTriangle> ReadLiquids(const std::filesystem::path& bvh,
+                                              const math::AABBTree& geometry)
+{
+    auto const path = bvh.string() + ".liquids";
+    if (!std::filesystem::exists(path))
+        return {};
+    BinaryStream input(path);
+    if (input.wpos() < 16)
+        throw std::runtime_error("Truncated WMO liquid metadata: " + path);
+    std::uint32_t magic, count;
+    std::uint64_t hash;
+    input >> magic >> count >> hash;
+    if (magic != 0x31514c57 || hash != GeometryHash(geometry) ||
+        count > 1000000 || input.wpos() != 16ULL + 40ULL * count)
+        throw std::runtime_error("Invalid WMO liquid metadata: " + path);
+    std::vector<LiquidTriangle> liquids(count);
+    for (auto& liquid : liquids)
+    {
+        for (auto& vertex : liquid.vertices)
+            input >> vertex;
+        input >> liquid.entry;
+        if (!ValidLiquid(liquid))
+            throw std::runtime_error("Invalid WMO liquid triangle: " + path);
+    }
+    return liquids;
+}
+
+inline void WriteLiquids(const std::filesystem::path& bvh, const math::AABBTree& geometry,
+                         const std::vector<LiquidTriangle>& liquids)
+{
+    BinaryStream output;
+    output << std::uint32_t(0x31514c57) << std::uint32_t(liquids.size()) << GeometryHash(geometry);
+    for (const auto& liquid : liquids)
+    {
+        if (!ValidLiquid(liquid))
+            throw std::runtime_error("Invalid WMO liquid triangle");
+        for (const auto& vertex : liquid.vertices)
+            output << vertex;
+        output << liquid.entry;
+    }
+    auto const path = bvh.string() + ".liquids";
+    auto const temporary = path + ".tmp";
+    std::ofstream file(temporary, std::ios::binary | std::ios::trunc);
+    file << output;
+    file.close();
+    if (!file)
+        throw std::runtime_error("Could not write WMO liquid metadata: " + temporary);
+    std::filesystem::rename(temporary, path);
+}
+}
diff --git a/utility/WmoLiquidsTests.cpp b/utility/WmoLiquidsTests.cpp
new file mode 100644
index 0000000..43164a2
--- /dev/null
+++ b/utility/WmoLiquidsTests.cpp
@@ -0,0 +1,81 @@
+#include "WmoLiquids.hpp"
+#include <chrono>
+#include <iostream>
+#include <limits>
+
+namespace
+{
+void Require(bool condition, const char* message)
+{
+    if (!condition)
+        throw std::runtime_error(message);
+}
+
+template<typename F>
+void Reject(F action)
+{
+    try { action(); }
+    catch (const std::exception&) { return; }
+    throw std::runtime_error("Invalid metadata accepted");
+}
+
+void Verify(const std::filesystem::path& directory)
+{
+    using namespace utility::wmo;
+    auto path = directory / "fixture.bvh";
+    std::vector<math::Vertex> vertices {{0, 0, -5}, {4, 0, -5}, {0, 4, -5}};
+    math::AABBTree geometry(vertices, {0, 1, 2});
+    Require(ReadLiquids(path, geometry).empty(), "Legacy file must remain loadable");
+    std::vector<LiquidTriangle> liquids {{{{0, 0, 0}, {4, 0, 4}, {0, 4, 0}}, 3}};
+    WriteLiquids(path, geometry, liquids);
+    auto loaded = ReadLiquids(path, geometry);
+    Require(loaded.size() == 1 && loaded[0].entry == 3, "Liquid identity lost");
+    math::Ray ray({1, 1, 10}, {1, 1, -10});
+    float fraction;
+    Require(ray.IntersectTriangle(loaded[0].vertices, &fraction), "Sloped liquid missing");
+    Require(std::abs(10 - 20 * fraction - 1) < 0.001f, "Sloped liquid height lost");
+    math::Ray outside({3, 3, 10}, {3, 3, -10});
+    Require(!outside.IntersectTriangle(loaded[0].vertices), "Empty liquid region filled");
+
+    liquids[0].vertices[0].Z = std::numeric_limits<float>::quiet_NaN();
+    Reject([&] { WriteLiquids(path, geometry, liquids); });
+    Require(ReadLiquids(path, geometry).size() == 1, "Rejected write replaced metadata");
+    vertices[0].Z = -6;
+    math::AABBTree changed(vertices, {0, 1, 2});
+    Reject([&] { ReadLiquids(path, changed); });
+    std::filesystem::resize_file(path.string() + ".liquids", 1);
+    Reject([&] { ReadLiquids(path, geometry); });
+    WriteLiquids(path, geometry, loaded);
+    std::filesystem::resize_file(path.string() + ".liquids", 50);
+    Reject([&] { ReadLiquids(path, geometry); });
+    WriteLiquids(path, geometry, {});
+    Require(ReadLiquids(path, geometry).empty(), "Dry WMO must be empty");
+
+    Require(LiquidEntry(0, 0, 0, 0, {}) == 1, "Water classification");
+    Require(LiquidEntry(0, 0, 0x80000, 0, {}) == 2, "Ocean group override");
+    Require(LiquidEntry(0, 0, 0, 2, {}) == 3, "Magma classification");
+    Require(LiquidEntry(0, 0, 0, 3, {}) == 4, "Ordinary slime classification");
+    Require(LiquidEntry(0, 4489, 0, 3, {}) == 21, "Naxxramas slime classification");
+    Require(LiquidEntry(4, 0, 0, 3, {}) == 3, "Direct liquid entry");
+    Require(LiquidEntry(0, 0, 0, 15, {15, 15, 2}) == 3, "Tile type fallback");
+    Require(LiquidEntry(0, 0, 0, 15, {15, 15}) == 0, "Hidden tiles have no liquid");
+}
+}
+
+int main()
+{
+    auto nonce = std::chrono::steady_clock::now().time_since_epoch().count();
+    auto directory = std::filesystem::temp_directory_path() / ("wmo-liquids-" + std::to_string(nonce));
+    std::filesystem::create_directory(directory);
+    try
+    {
+        Verify(directory);
+        std::filesystem::remove_all(directory);
+        return 0;
+    }
+    catch (const std::exception& error)
+    {
+        std::cerr << error.what() << " in " << directory << std::endl;
+        return 1;
+    }
+}
