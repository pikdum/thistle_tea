+std::optional<std::tuple<std::uint32_t, float, float>> Map::WmoLiquid(const math::Vertex& position) const
+{
+    auto const tile = GetTile(position.X, position.Y);
+    if (!tile)
+        return std::nullopt;
+
+    std::optional<std::tuple<std::uint32_t, float, float>> result;
+    float bestDistance = std::numeric_limits<float>::max();
+    for (auto id : tile->m_staticWmos)
+    {
+        auto const& instance = m_staticWmos.at(id);
+        auto const model = instance.m_model.lock();
+        if (!model || model->m_liquids.empty())
+            continue;
+        auto const bottom = instance.m_bounds.getMinimum().Z - 1.0f;
+        math::Vertex start {position.X, position.Y, instance.m_bounds.getMaximum().Z + 1.0f};
+        math::Vertex end {position.X, position.Y, bottom};
+        math::Ray ray(start, end);
+        if (!ray.IntersectBoundingBox(instance.m_bounds))
+            continue;
+        auto inverse = [&](const math::Vertex& v) { return math::Vector3::Transform(v, instance.m_inverseTransformMatrix); };
+        math::Ray surfaceRay(inverse(start), inverse(end));
+        math::Ray floorRay(inverse({position.X, position.Y, position.Z + 2.0f}), inverse(end));
+        if (!model->m_aabbTree.IntersectRay(floorRay))
+            continue;
+        float floor = math::Vector3::Transform(floorRay.GetHitPoint(), instance.m_transformMatrix).Z;
+        float terrain;
+        if (GetADTHeight(tile, position.X, position.Y, terrain) && terrain <= position.Z + 2.0f)
+            floor = std::max(floor, terrain);
+        if (position.Z < floor - 2.0f)
+            continue;
+        for (const auto& liquid : model->m_liquids)
+        {
+            float fraction;
+            if (!surfaceRay.IntersectTriangle(liquid.vertices, &fraction))
+                continue;
+            float const surface = start.Z + (end.Z - start.Z) * fraction;
+            float const distance = std::abs(surface - position.Z);
+            if (surface > floor && distance < bestDistance)
+            {
+                result = std::make_tuple(liquid.entry, surface, floor);
+                bestDistance = distance;
+            }
+        }
+    }
+    return result;
+}
