+std::optional<bool> Map::IsOutdoors(const math::Vertex& position) const
+{
+    auto const tile = GetTile(position.X, position.Y);
+    if (!tile)
+        return std::nullopt;
+
+    math::Vertex origin {position.X, position.Y, position.Z + 1.0f};
+    math::Ray ray {origin, {origin.X, origin.Y, tile->m_bounds.getMinimum().Z - 1.0f}};
+    std::optional<std::uint32_t> flags;
+    auto const hit = RayCast(ray, {tile}, false, nullptr, nullptr, &flags);
+
+    float height;
+    if (GetADTHeight(tile, origin.X, origin.Y, height) &&
+        origin.Z + 2.0f > height && height > ray.GetHitPoint().Z)
+        return true;
+
+    if (!hit)
+        return true;
+    if (!flags)
+        return std::nullopt;
+    return (*flags & 0x8000) != 0;
+}
