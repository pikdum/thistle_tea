@@ -0,0 +1,62 @@
+#pragma once
+
+#include "parser/MpqManager.hpp"
+#include "parser/Wmo/Wmo.hpp"
+#include "utility/AABBTree.hpp"
+#include "utility/BinaryStream.hpp"
+#include "utility/String.hpp"
+#include "utility/WmoGroupFlags.hpp"
+
+#include <filesystem>
+#include <iostream>
+#include <stdexcept>
+
+inline void UpdateWmoMetadata(const std::filesystem::path& data,
+                             const std::filesystem::path& output)
+{
+    auto const directory = output / "BVH";
+    auto const indexPath = directory / "bvh.idx";
+    if (!std::filesystem::is_regular_file(indexPath))
+        throw std::runtime_error("Existing BVH index required: " + indexPath.string());
+
+    parser::sMpqManager.Initialize(data);
+    utility::BinaryStream index(indexPath);
+    std::uint32_t count;
+    index >> count;
+    std::uint32_t updated = 0;
+    std::uint32_t missing = 0;
+
+    for (std::uint32_t i = 0; i < count; ++i)
+    {
+        std::uint32_t size;
+        index >> size;
+        auto const mpq = index.ReadString(size);
+        index >> size;
+        auto const filename = index.ReadString(size);
+        if (utility::lower(std::filesystem::path(mpq).extension().string()) != ".wmo")
+            continue;
+
+        auto const path = directory / filename;
+        if (!std::filesystem::is_regular_file(path))
+        {
+            ++missing;
+            continue;
+        }
+        utility::BinaryStream input(path);
+        math::AABBTree tree;
+        if (!tree.Deserialize(input))
+            throw std::runtime_error("Invalid existing WMO: " + path.string());
+
+        parser::Wmo wmo(mpq);
+        if (tree.Vertices() != wmo.Vertices)
+            throw std::runtime_error("WMO client geometry differs from existing bake: " + mpq);
+
+        utility::wmo::WriteGroupFlags(path, tree, wmo.VertexGroupFlags);
+        ++updated;
+        if (updated % 50 == 0)
+            std::cout << "Updated " << updated << " WMO metadata files" << std::endl;
+    }
+
+    std::cout << "Updated " << updated << " WMO metadata files" << std::endl;
+    std::cout << "Skipped " << missing << " unbaked WMO index entries" << std::endl;
+}
