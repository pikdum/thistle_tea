+++ b/utility/WmoGroupFlagsTests.cpp
@@ -0,0 +1,90 @@
+#include "WmoGroupFlags.hpp"
+
+#include <chrono>
+#include <fstream>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+
+namespace
+{
+void Require(bool condition, const char* message)
+{
+    if (!condition)
+        throw std::runtime_error(message);
+}
+
+template<typename F>
+void Reject(F action, const char* message)
+{
+    try
+    {
+        action();
+    }
+    catch (const std::exception&)
+    {
+        return;
+    }
+    throw std::runtime_error(message);
+}
+
+void Verify(const std::filesystem::path& path)
+{
+    std::vector<math::Vertex> vertices {
+        {3, -1, 0}, {5, -1, 0}, {4, 1, 0},
+        {-5, -1, 0}, {-3, -1, 0}, {-4, 1, 0}
+    };
+    std::vector<int> indices {0, 1, 2, 3, 4, 5};
+    math::AABBTree tree(vertices, indices);
+    Require(utility::wmo::ReadGroupFlags(path, tree).empty(), "Legacy geometry must have unknown group flags");
+
+    utility::wmo::WriteGroupFlags(path, tree, {0x8000, 0x8000, 0x8000, 0x2000, 0x2000, 0x2000});
+    auto const flags = utility::wmo::ReadGroupFlags(path, tree);
+    Require(flags.size() == 2, "Metadata must contain both faces");
+
+    for (auto x : {-4.0f, 4.0f})
+    {
+        math::Ray ray {{x, 0, 1}, {x, 0, -1}};
+        unsigned int face;
+        Require(tree.IntersectRay(ray, &face), "Expected fixture floor");
+        Require(flags.at(face) == (x > 0 ? 0x8000u : 0x2000u), "Group flags must follow reordered collision faces");
+    }
+
+    utility::BinaryStream binary;
+    tree.Serialize(binary);
+    math::AABBTree loaded;
+    Require(loaded.Deserialize(binary), "Geometry roundtrip failed");
+    Require(utility::wmo::ReadGroupFlags(path, loaded) == flags, "Metadata must survive geometry roundtrip");
+
+    vertices[0].Z = 1;
+    math::AABBTree changed(vertices, indices);
+    Reject([&] { utility::wmo::ReadGroupFlags(path, changed); }, "Stale geometry metadata was accepted");
+    Reject([&] { utility::wmo::WriteGroupFlags(path, tree, {0, 0x8000, 0x8000, 0, 0, 0}); }, "Mixed-group face was accepted");
+    Require(utility::wmo::ReadGroupFlags(path, tree) == flags, "Rejected write changed valid metadata");
+
+    auto const metadata = utility::wmo::GroupFlagsPath(path);
+    std::filesystem::resize_file(metadata, 1);
+    Reject([&] { utility::wmo::ReadGroupFlags(path, tree); }, "Truncated header was accepted");
+    utility::wmo::WriteGroupFlags(path, tree, {0, 0, 0, 0, 0, 0});
+    std::filesystem::resize_file(metadata, 20);
+    Reject([&] { utility::wmo::ReadGroupFlags(path, tree); }, "Truncated face metadata was accepted");
+}
+}
+
+int main()
+{
+    auto const nonce = std::chrono::steady_clock::now().time_since_epoch().count();
+    auto const directory = std::filesystem::temp_directory_path() / ("namigator-wmo-test-" + std::to_string(nonce));
+    std::filesystem::create_directory(directory);
+    try
+    {
+        Verify(directory / "fixture.bvh");
+        std::filesystem::remove_all(directory);
+        return 0;
+    }
+    catch (const std::exception& error)
+    {
+        std::cerr << error.what() << " in " << directory << std::endl;
+        return 1;
+    }
+}
