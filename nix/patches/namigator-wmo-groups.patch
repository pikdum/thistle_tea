+++ b/utility/WmoGroupFlags.hpp
@@ -0,0 +1,89 @@
+#pragma once
+
+#include "AABBTree.hpp"
+#include "BinaryStream.hpp"
+
+#include <cstdint>
+#include <filesystem>
+#include <fstream>
+#include <stdexcept>
+#include <vector>
+
+namespace utility
+{
+namespace wmo
+{
+constexpr std::uint32_t GroupFlagsMagic = 0x31464757;
+
+inline std::filesystem::path GroupFlagsPath(const std::filesystem::path& bvh)
+{
+    return bvh.string() + ".groups";
+}
+
+inline std::uint64_t GeometryHash(const math::AABBTree& tree)
+{
+    std::uint64_t hash = 14695981039346656037ULL;
+    auto append = [&hash](const void* data, std::size_t size) {
+        auto bytes = static_cast<const unsigned char*>(data);
+        for (std::size_t i = 0; i < size; ++i)
+        {
+            hash ^= bytes[i];
+            hash *= 1099511628211ULL;
+        }
+    };
+    append(tree.Vertices().data(), tree.Vertices().size() * sizeof(math::Vector3));
+    append(tree.Indices().data(), tree.Indices().size() * sizeof(int));
+    return hash;
+}
+
+inline std::vector<std::uint32_t> ReadGroupFlags(const std::filesystem::path& bvh,
+                                               const math::AABBTree& tree)
+{
+    auto const path = GroupFlagsPath(bvh);
+    if (!std::filesystem::exists(path))
+        return {};
+
+    BinaryStream input(path);
+    if (input.wpos() < 16)
+        throw std::runtime_error("Truncated WMO group metadata: " + path.string());
+
+    std::uint32_t magic, count;
+    std::uint64_t hash;
+    input >> magic >> count >> hash;
+    auto const faceCount = tree.Indices().size() / 3;
+    if (magic != GroupFlagsMagic || count != faceCount || hash != GeometryHash(tree) ||
+        input.wpos() != 16 + sizeof(std::uint32_t) * faceCount)
+        throw std::runtime_error("Invalid WMO group metadata: " + path.string());
+
+    std::vector<std::uint32_t> flags(count);
+    for (auto& value : flags)
+        input >> value;
+    return flags;
+}
+
+inline void WriteGroupFlags(const std::filesystem::path& bvh,
+                           const math::AABBTree& tree,
+                           const std::vector<std::uint32_t>& vertexFlags)
+{
+    BinaryStream output;
+    auto const& indices = tree.Indices();
+    output << GroupFlagsMagic << static_cast<std::uint32_t>(indices.size() / 3) << GeometryHash(tree);
+    for (std::size_t i = 0; i < indices.size(); i += 3)
+    {
+        auto const flags = vertexFlags.at(indices[i]);
+        if (flags != vertexFlags.at(indices[i + 1]) || flags != vertexFlags.at(indices[i + 2]))
+            throw std::runtime_error("WMO triangle crosses group metadata");
+        output << flags;
+    }
+
+    auto const path = GroupFlagsPath(bvh);
+    auto const temporary = path.string() + ".tmp";
+    std::ofstream file(temporary, std::ios::binary | std::ios::trunc);
+    file << output;
+    file.close();
+    if (!file)
+        throw std::runtime_error("Could not write WMO group metadata: " + temporary);
+    std::filesystem::rename(temporary, path);
+}
+}
+}
